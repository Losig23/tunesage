# TuneSage local config — copy to `.env` and fill in your values:
#   cp .env.example .env
# `.env` is gitignored and never committed. Real environment variables
# (shell exports, Render's Environment tab) take precedence over these.

# From https://www.last.fm/api/account/create
LASTFM_API_KEY=

# Your Last.fm username (the account name, not the app name)
LASTFM_USERNAME=

# Optional: tempo data for BPM streams — free key at https://getsongbpm.com/api
# (their terms ask for a backlink, shown in the dashboard footer).
# GETSONGBPM_API_KEY=

# Optional: Spotify playback (play recommendations on your devices).
# Create an app at https://developer.spotify.com/dashboard with redirect
# URI http://127.0.0.1:5001/api/spotify/callback (127.0.0.1, not localhost).
# Playback control requires Spotify Premium. Playback only: no Spotify
# data feeds the recommender (see README).
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:5001/api/spotify/callback

# Optional: Flask session signing key. If unset, a random dev key is
# generated on each start (fine locally; set a stable one in production).
# SECRET_KEY=
